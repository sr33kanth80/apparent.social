VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Required server-side in production. Among other backend work, this powers the
# atomic Agent limiter, run admission, spend ledger, and reconnect status.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
VITE_APP_URL=
VITE_KINDE_CLIENT_ID=
VITE_KINDE_DOMAIN=
VITE_KINDE_AUDIENCE=
VITE_KINDE_REDIRECT_URI=
VITE_KINDE_LOGOUT_URI=
# Optional server-only aliases. The agent API falls back to the VITE_ values.
KINDE_DOMAIN=
KINDE_AUDIENCE=
# Optional one-click connection ids — grab from Kinde dashboard
# (Settings → Authentication → each provider's `conn_…` id). When set, the
# matching button on /login skips Kinde's picker and routes straight into
# that provider's flow. Leave empty to fall back to Kinde's hosted picker.
VITE_KINDE_GOOGLE_CONN_ID=
VITE_KINDE_EMAIL_PASSWORD_CONN_ID=
VITE_KINDE_USERNAME_PASSWORD_CONN_ID=
VITE_NETWORK_TILE_URL=

# Server-only Apparent agent runtime. Never prefix these with VITE_ or expose
# them to browser code. Apparent defaults to Orthogonal's verified Baseten
# OpenAI-compatible endpoint and GLM-5.2; override these only when deliberately
# switching to another approved non-Anthropic/OpenAI catalog model.
ORTHOGONAL_API_KEY=
ORTHOGONAL_INFERENCE_API=baseten
ORTHOGONAL_INFERENCE_PATH=/v1/chat/completions
APPARENT_AGENT_MODEL=zai-org/GLM-5.2
# Runaway-loop stop, not a cost guard — ORTHOGONAL_AGENT_MAX_SPEND_CENTS caps
# spend. The agent lifts anything too small to finish its own step limit.
ORTHOGONAL_AGENT_MAX_CALLS=44
ORTHOGONAL_AGENT_MAX_SPEND_CENTS=100
# Pre-call budget reservation for the configured usage-priced inference endpoint.
# Orthogonal's reported priceCents replaces this estimate after each response.
ORTHOGONAL_DYNAMIC_PRICE_ESTIMATE_CENTS=10
ORTHOGONAL_TIMEOUT_MS=90000
ORTHOGONAL_MAX_RETRIES=1
ORTHOGONAL_RETRY_BASE_DELAY_MS=300

# Public-launch Agent safety. Production/Vercel fails closed when the Supabase
# limiter or run-control RPC is unavailable. Defaults shown are deliberately
# conservative until Orthogonal confirms the account's sustained/burst quota.
AGENT_GLOBAL_CONCURRENCY_MAX=8
AGENT_USER_CONCURRENCY_MAX=1
AGENT_RUN_LEASE_SECONDS=285
AGENT_SAFE_RUNTIME_MS=240000
AGENT_USER_DAILY_SPEND_CENTS=500
AGENT_GLOBAL_DAILY_SPEND_CENTS=10000
AGENT_REQUIRE_PERSISTENT_RATE_LIMIT=true
AGENT_REQUIRE_DISTRIBUTED_CONTROL=true
