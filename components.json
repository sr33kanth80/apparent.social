{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@mapcn": "https://mapcn.dev/r/{name}.json",
    "@efferd": "https://efferd.com/r/{style}/{name}.json",
    "@mynaui": "https://mynaui.com/r/{name}.json",
    "@kokonutui": "https://kokonutui.com/r/{name}.json"
  }
}
